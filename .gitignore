# ── 환경변수 / 시크릿 ─────────────────────────────
.env
.env.*
!.env.example

# ── macOS ─────────────────────────────────────────
.DS_Store
**/.DS_Store

# ── Node / npm ────────────────────────────────────
node_modules/
**/node_modules/
npm-debug.log*

# ── Next.js ───────────────────────────────────────
web/.next/
web/out/
web/.vercel/
web/next-env.d.ts

# ── TypeScript 빌드 캐시 ──────────────────────────
web/tsconfig.tsbuildinfo
cli/tsconfig.tsbuildinfo

# ── Drizzle 마이그레이션 ────────────────────────
# drizzle/*.sql + drizzle/meta/_journal.json 모두 tracked — 팀이 동일한 마이그 상태 공유.
# (이전 패턴 'web/drizzle/' 는 inline 주석 때문에 broken 이었고 SQL 만 강제 add 되어 있었음.)

# ── 로컬 단독 모드 SQLite 데이터 ──────────────────
web/*.sqlite3
web/*.sqlite3-shm
web/*.sqlite3-wal

# ── 인스톨러 빌드 산출물 ────────────────────────
installer/mac/build/
installer/mac/dist/
installer/windows/build/
installer/windows/dist/
installer/electron/staged/
installer/electron/dist/
installer/electron/node_modules/
installer/electron/cache/

# ── Apple codesign 인증서 (절대 commit 금지) ─────
*.p12
*.cer
installer/electron/build-resources/cert.*

# ── CLI 빌드 결과 ─────────────────────────────────
# cli/src/{index,sync,init}.mjs 는 commit 대상 — install.sh 가 호출하는
# `npx github:eugene-eee-hongkyu/ai-usage-tracker init` 흐름이 GitHub repo 의
# cli/package.json 의 `bin` (= ./src/index.mjs) 을 entry point 로 끌어씀.
# 매 cli/src/*.ts 변경 후 `cd cli && bun run build` 결과를 함께 commit 할 것.

# ── 하네스 내부 상태 ──────────────────────────────

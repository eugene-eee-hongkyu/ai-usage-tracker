#!/bin/bash
# .pkg postinstall — /usr/local/bin/usage-tracker wrapper 생성.
# 사용자 디렉토리 (~/.usage-tracker, launchd plist) 셋업은 first-run 시 launcher 가 처리
# (postinstall 은 root 권한이라 사용자 home 접근이 복잡함).
set -e

INSTALL_DIR=/usr/local/lib/ai-usage-tracker
BIN_PATH=/usr/local/bin/usage-tracker

NODE_BIN=$(command -v node || echo "/usr/local/bin/node")

mkdir -p /usr/local/bin

cat > "$BIN_PATH" <<EOF
#!/bin/bash
# AI Usage Tracker launcher wrapper — generated by installer postinstall.
exec "$NODE_BIN" "$INSTALL_DIR/installer/launcher.mjs" "\$@"
EOF
chmod +x "$BIN_PATH"

echo "✅ /usr/local/bin/usage-tracker 설치 완료"
echo "   터미널에서 'usage-tracker' 실행 → 대시보드 자동 오픈"
exit 0
